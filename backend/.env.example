# Application
APP_NAME=Project DNA API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Security
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=project_dna

# Qdrant Cloud (Phase 3+)
# Leave QDRANT_URL empty to use in-memory vectors for local demos.
QDRANT_URL=https://<cluster>.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=project_dna_chunks

# Embeddings / chunking (Phase 3)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# LLM (Phase 4+)
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# GitHub (optional for higher rate limits)
GITHUB_TOKEN=

# CORS — comma-separated origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
